# Copy to backend/.env. Never commit .env.
# Local development does not use Docker. The database file is created
# only when application code opens a connection.

ENVIRONMENT=development

# Local development and the automated checks. Leave unset for backend/data/hostel.db.
# Production ignores this and refuses to start while it is set.
# DATABASE_PATH=

# Render only. A laptop ignores these and opens the local SQLite file.
# libsql:// and turso:// URLs both work.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

SQLITE_BUSY_TIMEOUT_MS=5000

# mock is required unless ENVIRONMENT=production.
# A non-production process refuses to start with any other driver.
SMS_DRIVER=mock

# Required. At least 32 bytes. The process refuses to start when empty or short.
# Put a long random value in the untracked backend/.env only.
APP_SECRET_KEY=

# Optional. Local `python -m app.dev_seed` only. Never set these on Render.
# Read through the app settings loader, so values here are used. Per-role values
# win over BSJ_SEED_PASSWORD. When unset, the seed generates a strong random
# password and prints it once (only for accounts it creates). Existing accounts
# are left unchanged; `python -m app.dev_seed --reset-passwords` resets them.
# Values from here or the environment are never printed.
# BSJ_SEED_PASSWORD=
# BSJ_SEED_PASSWORD_GATE=
# BSJ_SEED_PASSWORD_RESIDENT=
# BSJ_SEED_PASSWORD_SUSPENDED=
# BSJ_SEED_PASSWORD_WARDEN=
# BSJ_SEED_PASSWORD_PROVOST=


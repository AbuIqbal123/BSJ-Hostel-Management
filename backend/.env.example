# Copy to backend/.env. Never commit .env.
# Local development does not use Docker. The database file is created
# only when application code opens a connection.

ENVIRONMENT=development

# Leave unset to use backend/data/hostel.db.
# On the VPS this is /data/hostel.db inside that environment's volume.
# DATABASE_PATH=

SQLITE_BUSY_TIMEOUT_MS=5000

# mock is required unless ENVIRONMENT=production.
# A non-production process refuses to start with any other driver.
SMS_DRIVER=mock

# Required. The process refuses to start when this is empty.
# Put a long random value in the untracked backend/.env only.
APP_SECRET_KEY=

# Optional. FastAPI records request traces, metrics, and logs on its own.
# Nothing is sent until an OpenTelemetry collector endpoint is set.
# OTEL_SERVICE_NAME=begum-sultan-jahan-hall
# OTEL_EXPORTER_OTLP_ENDPOINT=
